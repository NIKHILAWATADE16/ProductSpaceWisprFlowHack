# ==========================================
# Personal Finance Coach - Environment Configuration
# ==========================================

# Server Configuration
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financecoach
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security & JWT Configuration
JWT_SECRET=9a4f2c8d7e1b5a3f6c8d0e2b4a7c9f1e3d5b7a9c1e3f5a7b9c1d3e5f7a9b1c3d
JWT_EXPIRATION_MS=86400000

# AI Financial Coach (Claude / OpenAI / Compatible LLM)
# If left blank, the application automatically uses deterministic financial calculations fallback
LLM_PROVIDER=claude
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_URL=https://api.anthropic.com/v1/messages

# Frontend CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

