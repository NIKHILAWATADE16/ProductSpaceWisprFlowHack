# ==========================================
# Personal Finance Coach - Environment Configuration
# ==========================================

# Server Configuration
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financecoach
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security & JWT Configuration
JWT_SECRET=9a4f2c8d7e1b5a3f6c8d0e2b4a7c9f1e3d5b7a9c1e3f5a7b9c1d3e5f7a9b1c3d
JWT_EXPIRATION_MS=86400000

# AI Financial Coach (Google Gemini)
# If left blank, the application automatically uses deterministic financial calculations fallback
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# Frontend CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

